DECLARE @t sysname = 'iris_customer';
DECLARE @codes varchar(max) = ',DELTA_TYPE,DECEASED_INDICATOR,GENDER,MARITAL_STATUS,ADDRESS_TYPE,STATE,ADDRESS_CLEANSED_FLAG,ADDRESS_DELIVERABLE_FLAG,NCOA_ACTION,NCOA_DELIVERY,NCOA_MOVE_TYPE,WEALTH_CODE,OPT_OUT_REASON,DOB_SOURCE_INDICATOR,COUNTY,Event_type,';
SELECT STRING_AGG(CAST(
  'SELECT ''' + @t + ''' AS source_table, ''' + COLUMN_NAME + ''' AS column_name, ''' + DATA_TYPE + ''' AS data_type, '
  + 'COUNT(*) AS total_rows, '
  + 'SUM(CASE WHEN [' + COLUMN_NAME + '] IS NULL THEN 1 ELSE 0 END) AS nulls, '
  + 'SUM(CASE WHEN LTRIM(RTRIM(CAST([' + COLUMN_NAME + '] AS VARCHAR(8000)))) = '''' THEN 1 ELSE 0 END) AS blanks, '
  + 'COUNT(DISTINCT [' + COLUMN_NAME + ']) AS distinct_values, '
  + CASE
      WHEN (DATA_TYPE IN ('varchar','char','nvarchar','nchar') AND CHARINDEX(',' + COLUMN_NAME + ',', @codes) = 0)
           OR COLUMN_NAME IN ('DATE_OF_BIRTH','DATE_OF_DEATH','BIRTH_DATE')
        THEN 'NULL AS min_value, NULL AS max_value, '
      WHEN DATA_TYPE IN ('bigint','int','smallint','tinyint','decimal','numeric','float','real')
        THEN 'CAST(MIN([' + COLUMN_NAME + ']) AS VARCHAR(100)) AS min_value, CAST(MAX([' + COLUMN_NAME + ']) AS VARCHAR(100)) AS max_value, '
      ELSE 'MIN(CAST([' + COLUMN_NAME + '] AS VARCHAR(100))) AS min_value, MAX(CAST([' + COLUMN_NAME + '] AS VARCHAR(100))) AS max_value, '
    END
  + 'MAX(LEN(CAST([' + COLUMN_NAME + '] AS VARCHAR(8000)))) AS max_len FROM mpi_bronze.' + @t
  AS VARCHAR(MAX)), ' UNION ALL ') AS paste_this_into_a_new_query
FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_SCHEMA = 'mpi_bronze' AND TABLE_NAME = @t;



SELECT 'RTMI' AS src, COUNT(*) AS nine_digit_rows,
  SUM(CASE WHEN LEFT(SSN_TOKEN,3) IN ('000','666') OR LEFT(SSN_TOKEN,1)='9'
            OR SUBSTRING(SSN_TOKEN,4,2)='00' OR RIGHT(SSN_TOKEN,4)='0000' THEN 1 ELSE 0 END) AS impossible_ssn_pattern
FROM mpi_bronze.rtmi_individual WHERE LEN(SSN_TOKEN)=9 AND SSN_TOKEN NOT LIKE '%[^0-9]%'
UNION ALL
SELECT 'IRIS', COUNT(*),
  SUM(CASE WHEN LEFT(SSN_TOKEN,3) IN ('000','666') OR LEFT(SSN_TOKEN,1)='9'
            OR SUBSTRING(SSN_TOKEN,4,2)='00' OR RIGHT(SSN_TOKEN,4)='0000' THEN 1 ELSE 0 END)
FROM mpi_bronze.iris_customer WHERE LEN(SSN_TOKEN)=9 AND SSN_TOKEN NOT LIKE '%[^0-9]%';



SELECT 'RTMI' AS src, LEFT(SSN_TOKEN,1) AS first_digit, COUNT(*) AS n
FROM mpi_bronze.rtmi_individual WHERE LEN(SSN_TOKEN)=9 AND SSN_TOKEN NOT LIKE '%[^0-9]%'
GROUP BY LEFT(SSN_TOKEN,1)
UNION ALL
SELECT 'IRIS', LEFT(SSN_TOKEN,1), COUNT(*)
FROM mpi_bronze.iris_customer WHERE LEN(SSN_TOKEN)=9 AND SSN_TOKEN NOT LIKE '%[^0-9]%'
GROUP BY LEFT(SSN_TOKEN,1)
ORDER BY src, first_digit;


SELECT n_open_rows, COUNT(*) AS id_delivery_pairs
FROM (
  SELECT IRIS_ID, IngestedTime,
         SUM(CASE WHEN EndDate >= '9999-01-01' THEN 1 ELSE 0 END) AS n_open_rows
  FROM mpi_bronze.iris_customer
  GROUP BY IRIS_ID, IngestedTime
  HAVING COUNT(*) > 1
) x
GROUP BY n_open_rows ORDER BY n_open_rows;



/* IRIS duplicate pairs: what separates the two rows? IDs and event columns only. */
WITH pairs AS (
  SELECT TOP 5 IRIS_ID, IngestedTime
  FROM mpi_bronze.iris_customer
  GROUP BY IRIS_ID, IngestedTime
  HAVING COUNT(*) = 2
)
SELECT c.IRIS_ID, c.IngestedTime, c.Event_type, c.Event_id, c.StartDate, c.EndDate
FROM mpi_bronze.iris_customer AS c
JOIN pairs AS p
  ON p.IRIS_ID = c.IRIS_ID AND p.IngestedTime = c.IngestedTime
ORDER BY c.IRIS_ID, c.IngestedTime, c.StartDate;




/* Across all two-row duplicate groups: how many differ on each column? */
SELECT
  COUNT(*)                                        AS pairs,
  SUM(CASE WHEN n_event_type > 1 THEN 1 ELSE 0 END) AS differ_event_type,
  SUM(CASE WHEN n_event_id   > 1 THEN 1 ELSE 0 END) AS differ_event_id,
  SUM(CASE WHEN n_start      > 1 THEN 1 ELSE 0 END) AS differ_startdate,
  SUM(CASE WHEN n_end        > 1 THEN 1 ELSE 0 END) AS differ_enddate
FROM (
  SELECT IRIS_ID, IngestedTime,
         COUNT(DISTINCT Event_type) AS n_event_type,
         COUNT(DISTINCT Event_id)   AS n_event_id,
         COUNT(DISTINCT StartDate)  AS n_start,
         COUNT(DISTINCT EndDate)    AS n_end
  FROM mpi_bronze.iris_customer
  GROUP BY IRIS_ID, IngestedTime
  HAVING COUNT(*) = 2
) x;
