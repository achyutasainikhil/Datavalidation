SELECT 
    'MDM_INDIVIDUAL_DIM_WH' AS table_name,
    COUNT(*) AS total_rows,
    COUNT(DISTINCT INDIVIDUAL_ROW_HKEY) AS distinct_keys,
    MAX(RECORD_BEGIN_DATE) AS latest_rpo_timestamp
FROM cdwp.USER_DATAPRODUCTS_MDM_INDIVIDUAL_DIM_WH

UNION ALL

SELECT 
    'APPLICATION_POLICY_INDIVIDUAL_DIM_WH' AS table_name,
    COUNT(*) AS total_rows,
    COUNT(DISTINCT APPLICATION_POLICY_INDIVIDUAL_ROLE_ROW_HKEY) AS distinct_keys,
    MAX(ETL_BEGIN_TS) AS latest_rpo_timestamp
FROM cdwp.USER_DATAPRODUCTS_APPLICATION_POLICY_INDIVIDUAL_DIM_WH

UNION ALL

SELECT 
    'APPLICATION_POLICY_FACT_WH' AS table_name,
    COUNT(*) AS total_rows,
    COUNT(DISTINCT APPLICATION_KEY_HKEY) AS distinct_keys,
    MAX(ETL_BEGIN_TS) AS latest_rpo_timestamp
FROM cdwp.USER_DATAPRODUCTS_APPLICATION_POLICY_FACT_WH;
