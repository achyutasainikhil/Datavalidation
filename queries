    quality:
    - id: iris_customer_row_count_positive
      type: custom
      engine: sql
      name: Row Count Positive
      description: Table must contain at least one row after each load.
      severity: critical
      implementation: |-
        SELECT COUNT(*)
        FROM lh_silver.dbo.iris_customer
        HAVING COUNT(*) = 0
    - id: iris_customer_required_fields_not_null
      type: custom
      engine: sql
      name: Null Check Required Columns
      description: IRIS_ID, StartDate and IngestedTime must be non-null on every row. Returns count of offending rows, must be 0.
      severity: critical
      implementation: |-
        SELECT COUNT(*) AS offending_rows
        FROM lh_silver.dbo.iris_customer
        WHERE IRIS_ID IS NULL
           OR StartDate IS NULL
           OR IngestedTime IS NULL
        HAVING COUNT(*) > 0
    - id: iris_customer_unique_active_iris_id
      type: custom
      engine: sql
      name: Unique Active IRIS_ID
      description: At most one currently active row per IRIS_ID. Returns IRIS_IDs with more than one active row, must be 0.
      severity: critical
      implementation: |-
        SELECT IRIS_ID
        FROM lh_silver.dbo.iris_customer
        WHERE EndDate IS NULL OR EndDate > CURRENT_TIMESTAMP()
        GROUP BY IRIS_ID
        HAVING COUNT(*) > 1
    - id: iris_customer_end_after_start
      type: custom
      engine: sql
      name: EndDate After StartDate
      description: When EndDate is not null it must be strictly after StartDate.
      severity: error
      implementation: |-
        SELECT IRIS_ID
        FROM lh_silver.dbo.iris_customer
        WHERE EndDate IS NOT NULL AND StartDate IS NOT NULL
          AND EndDate <= StartDate
        GROUP BY IRIS_ID
        HAVING COUNT(*) > 0
    - id: iris_customer_birth_date_valid_range
      type: custom
      engine: sql
      name: Birth Date Valid Range
      description: When present, BIRTH_DATE must not be in the future or before 1900-01-01.
      severity: error
      implementation: |-
        SELECT IRIS_ID
        FROM lh_silver.dbo.iris_customer
        WHERE BIRTH_DATE IS NOT NULL
          AND (BIRTH_DATE > CURRENT_DATE() OR BIRTH_DATE < DATE '1900-01-01')
        GROUP BY IRIS_ID
        HAVING COUNT(*) > 0
    - id: iris_customer_ssn_token_not_raw_ssn
      type: custom
      engine: sql
      name: SSN Token Is Not A Raw SSN
      description: SSN_TOKEN must never hold a raw 9-digit SSN. Returns offending rows, must be 0. PII protection check.
      severity: critical
      implementation: |-
        SELECT IRIS_ID
        FROM lh_silver.dbo.iris_customer
        WHERE SSN_TOKEN IS NOT NULL
          AND SSN_TOKEN RLIKE '^[0-9]{3}-?[0-9]{2}-?[0-9]{4}$'
        GROUP BY IRIS_ID
        HAVING COUNT(*) > 0
    - id: iris_customer_ssn_last_four_format
      type: custom
      engine: sql
      name: SSN Last Four Format
      description: When present, SSN_LAST_FOUR must be exactly 4 digits. NULLs are skipped by RLIKE, so required-ness is not enforced here.
      severity: error
      implementation: |-
        SELECT IRIS_ID
        FROM lh_silver.dbo.iris_customer
        WHERE SSN_LAST_FOUR IS NOT NULL
          AND NOT (SSN_LAST_FOUR RLIKE '^[0-9]{4}$')
        GROUP BY IRIS_ID
        HAVING COUNT(*) > 0
    - id: iris_customer_start_date_not_in_future
      type: custom
      engine: sql
      name: StartDate Not In Future
      description: StartDate must not be later than the current timestamp. Warning until confirmed with the data steward.
      severity: warning
      implementation: |-
        SELECT IRIS_ID
        FROM lh_silver.dbo.iris_customer
        WHERE StartDate > CURRENT_TIMESTAMP()
        GROUP BY IRIS_ID
        HAVING COUNT(*) > 0
    - id: iris_customer_zip_state_format
      type: custom
      engine: sql
      name: ZIP And State Format
      description: When present, ZIP_CODE must be 5 digits or ZIP+4 and STATE two uppercase letters. Warning until the data has been profiled.
      severity: warning
      implementation: |-
        SELECT IRIS_ID
        FROM lh_silver.dbo.iris_customer
        WHERE (ZIP_CODE IS NOT NULL AND NOT (ZIP_CODE RLIKE '^[0-9]{5}(-?[0-9]{4})?$'))
           OR (STATE IS NOT NULL AND NOT (STATE RLIKE '^[A-Z]{2}$'))
        GROUP BY IRIS_ID
        HAVING COUNT(*) > 0
