    name: iris_customer
    catalog: lh_silver
    schema: dbo
    physicalName: iris_customer
    physicalType: table
    businessName: iris_customer
    description: Iris customer records with validity period
    dataGranularityDescription: One row per IRIS_ID per validity period (StartDate to EndDate) (TODO confirm)
    properties:
    - id: ic_iris_id_prop
      name: IRIS_ID
      logicalType: string
      physicalType: string
      description: IRIS ID.
    - id: ic_first_name_prop
      name: FIRST_NAME
