      description: Each (IrisId, RTMIMemberNumber, Action, File_Date) combination must appear once.
      severity: error
      implementation: |-
        SELECT IrisId, RTMIMemberNumber, Action, File_Date
        FROM lh_silver.dbo.iris_rtmi_mapping
        GROUP BY IrisId, RTMIMemberNumber, Action, File_Date
        HAVING COUNT(*) > 1
    - id: iris_rtmi_mapping_ingested_time_not_in_future
      type: custom
      engine: sql
      name: IngestedTime Not In Future
      description: IngestedTime must not be later than the current timestamp.
      severity: warning
      implementation: |-
        SELECT IrisId
        FROM lh_silver.dbo.iris_rtmi_mapping
        WHERE IngestedTime > CURRENT_TIMESTAMP()
        GROUP BY IrisId
        HAVING COUNT(*) > 0
    - id: iris_rtmi_mapping_iris_id_exists_in_customer
      type: custom
      engine: sql
      name: IrisId Exists In iris_customer
      description: Every IrisId must exist in iris_customer. Returns orphans, must be 0. Confirm with the steward before promoting past warning.
      severity: warning
      implementation: |-
        SELECT m.IrisId
        FROM lh_silver.dbo.iris_rtmi_mapping m
        LEFT JOIN lh_silver.dbo.iris_customer c
          ON m.IrisId = c.IRIS_ID
        WHERE m.IrisId IS NOT NULL
          AND c.IRIS_ID IS NULL
        GROUP BY m.IrisId
        HAVING COUNT(*) > 0
    - id: iris_rtmi_mapping_member_exists_in_rtmi_individual
      type: custom
      engine: sql
      name: RTMIMemberNumber Exists In rtmi_individual
      description: Every RTMIMemberNumber must exist in rtmi_individual (cross-contract check). Returns orphans, must be 0. Warning until the RTMI contract is confirmed.
      severity: warning
      implementation: |-
        SELECT m.RTMIMemberNumber
        FROM lh_silver.dbo.iris_rtmi_mapping m
        LEFT JOIN lh_silver.dbo.rtmi_individual i
          ON m.RTMIMemberNumber = i.RTMI_MEMBER_NUMBER
        WHERE m.RTMIMemberNumber IS NOT NULL
          AND i.RTMI_MEMBER_NUMBER IS NULL
        GROUP BY m.RTMIMemberNumber
        HAVING COUNT(*) > 0

