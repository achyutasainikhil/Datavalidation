      name: ingest_date
      logicalType: date
      physicalType: date
      description: ingest date.
    - id: im_eventtype_prop
      name: eventType
      logicalType: string
      physicalType: string
      description: eventType.
    quality:
    - id: iris_mapping_required_fields_not_null
      type: custom
      engine: sql
      name: Null Check Required Columns
      description: eventId and irisId must be non-null on every row. Returns count of offending rows, must be 0.
      severity: critical
      implementation: |-
        SELECT COUNT(*) AS offending_rows
        FROM lh_silver.dbo.iris_mapping
        WHERE eventId IS NULL
           OR irisId IS NULL
        HAVING COUNT(*) > 0
    - id: iris_mapping_no_duplicate_rows
      type: custom
      engine: sql
      name: No Duplicate Event Mappings
      description: Each (eventId, irisId, oldIrisId) combination must appear once.
      severity: error
      implementation: |-
        SELECT eventId, irisId, oldIrisId
        FROM lh_silver.dbo.iris_mapping
        GROUP BY eventId, irisId, oldIrisId
        HAVING COUNT(*) > 1
    - id: iris_mapping_old_differs_from_new
      type: custom
      engine: sql
      name: Old IrisId Differs From IrisId
      description: An Iris id cannot replace itself.
      severity: error
      implementation: |-
        SELECT irisId
        FROM lh_silver.dbo.iris_mapping
        WHERE oldIrisId IS NOT NULL AND irisId = oldIrisId
        GROUP BY irisId
        HAVING COUNT(*) > 0
    - id: iris_mapping_ingest_date_not_in_future
      type: custom
      engine: sql
      name: ingest_date Not In Future
      description: ingest_date must not be later than today.
      severity: warning
      implementation: |-
        SELECT irisId
        FROM lh_silver.dbo.iris_mapping
        WHERE ingest_date > CURRENT_DATE()
        GROUP BY irisId
        HAVING COUNT(*) > 0
    - id: iris_mapping_iris_id_exists_in_customer
      type: custom
      engine: sql
      name: irisId Exists In iris_customer
      description: Every irisId must exist in iris_customer. irisId is bigint here and IRIS_ID is string there, so the check casts. Returns orphans, must be 0. Confirm with the steward before promoting past warning.
      severity: warning
      implementation: |-
        SELECT m.irisId
        FROM lh_silver.dbo.iris_mapping m
        LEFT JOIN lh_silver.dbo.iris_customer c
          ON CAST(m.irisId AS STRING) = c.IRIS_ID
        WHERE m.irisId IS NOT NULL
          AND c.IRIS_ID IS NULL
        GROUP BY m.irisId
        HAVING COUNT(*) > 0
