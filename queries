SELECT 
    'shared_key_ring_entity' AS object_name,
    COUNT(*) AS total_rows,
    COUNT(DISTINCT KEY_RING_HKEY) AS distinct_keys,
    MAX(ETL_BEGIN_TS) AS latest_rpo_timestamp,
    DATEDIFF('minute', MAX(ETL_BEGIN_TS), CURRENT_TIMESTAMP()) AS latency_minutes
FROM CDWP_DB_PROD.USER_DATAPRODUCTS.SHARED_KEY_RING_ENTITY

UNION ALL

SELECT 
    'shared_key_ring_identifier' AS object_name,
    COUNT(*) AS total_rows,
    COUNT(DISTINCT KEY_RING_IDENTIFIER_HKEY) AS distinct_keys,
    MAX(ETL_BEGIN_TS) AS latest_rpo_timestamp,
    DATEDIFF('minute', MAX(ETL_BEGIN_TS), CURRENT_TIMESTAMP()) AS latency_minutes
FROM CDWP_DB_PROD.USER_DATAPRODUCTS.SHARED_KEY_RING_IDENTIFIER;
