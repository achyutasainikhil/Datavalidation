  - id: iris_mapping_obj
    name: iris_mapping
    catalog: lh_silver
    schema: dbo
    physicalName: iris_mapping
    physicalType: table
    businessName: iris_mapping
    description: Iris id replacement mapping per event
    dataGranularityDescription: One row per event, Iris id and old Iris id (TODO confirm)
    properties:
    - id: im_eventid_prop
      name: eventId
      logicalType: integer
      physicalType: bigint
      description: eventId.
    - id: im_irisid_prop
      name: irisId
      logicalType: integer
      physicalType: bigint
      description: irisId.
    - id: im_oldirisid_prop
      name: oldIrisId
      logicalType: integer
      physicalType: bigint
      description: oldIrisId.
    - id: im_source_file_prop
      name: _source_file
      logicalType: string
      physicalType: string
      description: ' source file.'
